<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Adrians-ed6d3076-4ff3-45de-b4a6-f218ad9df9be</UserSecretsId>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <!-- Barca's JSON DTOs use Newtonsoft.Json attributes. Keep this dependency explicit. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\.well-known\Security.txt" />
  </ItemGroup>
</Project>
