@model Adrians.Controllers.DigiNewsViewModel
@{
    ViewData["Title"] = "Teknologi og sikkerheit";
    var failed = Model.Sources.Count(source => !source.Available);
}
@section Styles {
    <link rel="stylesheet" href="~/css/digi-news.css" asp-append-version="true" />
}
<section aria-labelledby="newsTitle">
    <div class="news-header">
        <div>
            <div class="news-kicker">Adrians / Nyheitsoversikt</div>
        </div>
        <div class="text-end">
            <a class="btn btn-outline-success" asp-controller="Digi" asp-action="Index" aria-label="Hent oppdaterte nyheiter">↻ Oppdater sida</a>
        </div>
    </div>
    @if (failed > 0)
    {
        <div class="news-warning" role="status">
            @failed av @Model.Sources.Count kjelder er mellombels utilgjengelege.
            Me viser ikkje mellomlagra artiklar.
        </div>
    }

    <div class="news-controls" role="search" aria-label="Filtrer nyheiter">
        <label for="newsSearch" class="visually-hidden">Søk etter nyheit</label>
        <input id="newsSearch" class="news-search" type="search" placeholder="Søk i titlar, omtalar og kjelder …" autocomplete="off" />
        <label for="newsSource" class="visually-hidden">Vel kjelde</label>
        <select id="newsSource" class="news-select">
            <option value="">Alle kjelder</option>
            @foreach (var source in Model.Sources)
            {
                <option value="@source.Key">@source.Name</option>
            }
        </select>
        <label for="newsCategory" class="visually-hidden">Vel kategori</label>
        <select id="newsCategory" class="news-select">
            <option value="">Alle kategoriar</option>
            <option value="Varsel">Varsel</option>
            <option value="Sikkerheit">Sikkerheit</option>
            <option value="Utvikling">Utvikling</option>
        </select>
        <label for="newsPeriod" class="visually-hidden">Vel tidsrom</label>
        <select id="newsPeriod" class="news-select">
            <option value="0">Alle datoar</option>
            <option value="1">Siste døgn</option>
            <option value="7">Siste 7 dagar</option>
            <option value="30">Siste 30 dagar</option>
        </select>
    </div>

    <p id="newsCount" class="news-stats" role="status" aria-live="polite">@Model.Articles.Count saker frå @Model.Sources.Count kjelder</p>
    <p class="news-loaded">Sist henta frå kjeldene: @Model.LoadedAt.ToString("dd.MM.yyyy HH:mm:ss") UTC</p>

    <div id="newsList" class="news-list">
        @foreach (var article in Model.Articles)
        {
            <article class="news-card"
                     data-source="@article.SourceKey"
                     data-category="@article.Category"
                     data-date="@(article.PublishedAt?.ToUnixTimeSeconds().ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                <div class="news-card-meta">
                    <span class="news-category">@article.Category</span>
                    <span>@article.SourceName</span>
                    <span aria-hidden="true">·</span>
                    @if (article.PublishedAt is { } published)
                    {
                        <time datetime="@published.ToString("O")"
                              title="@published.ToString("yyyy-MM-dd HH:mm 'UTC'")">
                            @published.ToString("dd.MM.yyyy HH:mm") UTC
                        </time>
                    }
                    else
                    {
                        <span>Ukjend dato</span>
                    }
                </div>
                <h2 class="h6 mb-0"><a href="@article.Url" target="_blank" rel="noopener noreferrer">@article.Title</a></h2>
                @if (!string.IsNullOrWhiteSpace(article.Description))
                {
                    <p>@article.Description</p>
                }
            </article>
        }
    </div>
    <p id="newsEmpty" class="news-empty" @(Model.Articles.Count == 0 ? "" : "hidden")>Ingen saker passar med søket eller filtreringa. Prøv eit anna filter.</p>

        <div class="news-status" aria-label="Status for nyheitskjelder">
        @foreach (var source in Model.Sources)
        {
            <span class="source-pill @(!source.Available ? "offline" : "")"
                  title="@(source.Available ? "Kjelde tilgjengeleg" : "Kjelde utilgjengeleg")">
                @(source.Available ? "●" : "○") @source.Name
                <span aria-label="Tal på saker">(@source.ArticleCount)</span>
            </span>
        }
    </div>
    
</section>
@section Scripts {
<script>
(() => {
    const search = document.getElementById('newsSearch');
    const source = document.getElementById('newsSource');
    const category = document.getElementById('newsCategory');
    const period = document.getElementById('newsPeriod');
    const cards = [...document.querySelectorAll('.news-card')];
    const counter = document.getElementById('newsCount');
    const empty = document.getElementById('newsEmpty');
    const normalize = value => (value || '').toLocaleLowerCase('nb-NO');
    function filterNews() {
        const query = normalize(search.value.trim());
        const sourceValue = source.value;
        const categoryValue = category.value;
        const days = Number(period.value);
        const cutoff = days ? Date.now() / 1000 - days * 86400 : 0;
        let visible = 0;
        for (const card of cards) {
            const published = Number(card.dataset.date || 0);
            const show = (!query || normalize(card.textContent).includes(query))
                && (!sourceValue || card.dataset.source === sourceValue)
                && (!categoryValue || card.dataset.category === categoryValue)
                && (!days || (published > 0 && published >= cutoff));
            card.hidden = !show;
            if (show) visible++;
        }
        counter.textContent = visible + ' av ' + cards.length + ' saker';
        empty.hidden = visible !== 0;
    }
    [search, source, category, period].forEach(element =>
        element.addEventListener(element === search ? 'input' : 'change', filterNews));
    filterNews();
})();
</script>
}
