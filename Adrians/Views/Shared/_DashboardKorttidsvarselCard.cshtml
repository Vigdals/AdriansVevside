@model Adrians.ViewModels.KorttidsvarselViewModel
@using Adrians.Helpers

@{
    var iconCode = MetIconHelper.GetIconFile(Model.SymbolCode);
    var iconUrl = Url.Content($"~/assets/met-icons/svg/{iconCode}.svg");
    var fallbackUrl = Url.Content("~/assets/met-icons/svg/unknown.svg");
    var osloTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo");
    var updatedAt = TimeZoneInfo.ConvertTime(Model.UpdatedAt, osloTimeZone);
}

<div class="dashboard-weather-compact">
    <div class="dashboard-weather-main">
        <button type="button"
                class="dashboard-weather-effect-trigger"
                data-weather-symbol="@Model.SymbolCode"
                aria-label="Vis vêranimasjon for @Model.LocationName"
                title="Vis vêranimasjon">
            <img src="@iconUrl"
                 alt=""
                 class="dashboard-weather-icon"
                 loading="lazy"
                 onerror="this.onerror=null;this.src='@fallbackUrl';" />
        </button>

        <div class="dashboard-weather-primary">
            <div class="dashboard-weather-reading">
                @(Model.TemperatureC?.ToString("0.#") ?? "–")<span class="dashboard-weather-reading-unit">°C</span>
            </div>
            <span class="dashboard-weather-place">@Model.LocationName · no</span>
        </div>
    </div>

    <div class="dashboard-weather-metrics dashboard-weather-metrics-three">
        <div class="dashboard-weather-metric dashboard-weather-wind">
            <span>Vind</span>
            <strong>@(Model.WindSpeedMs?.ToString("0.#") ?? "–") m/s</strong>
        </div>
        <div class="dashboard-weather-metric">
            <span>Nedbør neste time</span>
            <strong>@(Model.PrecipNext1hMm?.ToString("0.#") ?? "–") mm</strong>
        </div>
    </div>

    <p class="dashboard-weather-updated">
        Oppdatert <time datetime="@Model.UpdatedAt.ToString("O")">@updatedAt.ToString("HH:mm")</time>
    </p>
</div>
