@model Adrians.ViewModels.TommekalenderViewModel

@functions {
    private static string GetDaysText(DateOnly date, DateOnly today)
    {
        var days = date.DayNumber - today.DayNumber;
        return days switch
        {
            < 0 => "",
            0 => "I dag",
            1 => "I morgon",
            _ => $"Om {days} dagar"
        };
    }
}

@{
    var osloTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo");
    var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, osloTimeZone).DateTime);
    var upcoming = Model.Tommingar
        .Where(item => item.NesteTomming.HasValue && item.NesteTomming.Value >= today)
        .OrderBy(item => item.NesteTomming)
        .ThenBy(item => item.Namn)
        .ToList();
    var nextDate = upcoming.FirstOrDefault()?.NesteTomming;
    var nextItems = upcoming.Where(item => item.NesteTomming == nextDate).ToList();
    var laterItems = upcoming.Where(item => item.NesteTomming != nextDate).ToList();
}

<article class="dashboard-card dashboard-hover-card dashboard-waste-card">
    <div class="dashboard-waste-header">
        <p class="dashboard-card-kicker">Tømmekalender</p>
        <div class="dashboard-waste-meta">
            <span class="dashboard-card-badge">SIMAS</span>
            @if (Model.SistOppdatert is not null)
            {
                <span class="dashboard-muted">
                    <time datetime="@Model.SistOppdatert.Value.ToString("O")">
                        @TimeZoneInfo.ConvertTime(Model.SistOppdatert.Value, osloTimeZone).ToString("HH:mm")
                    </time>
                </span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Feilmelding))
    {
        <p class="dashboard-muted mb-0">@Model.Feilmelding</p>
    }
    else if (upcoming.Count == 0)
    {
        <p class="dashboard-muted mb-0">Ingen komande tømmingar funne akkurat no.</p>
    }
    else
    {
        <div class="dashboard-waste-highlight">
            <div class="dashboard-waste-lead">
                <span class="dashboard-waste-lead-label">Neste henting</span>
                <strong class="dashboard-waste-lead-name">@string.Join(" + ", nextItems.Select(item => item.Namn))</strong>
                @if (nextDate.HasValue)
                {
                    <span class="dashboard-waste-lead-days">@GetDaysText(nextDate.Value, today)</span>
                }
            </div>
            @if (nextDate.HasValue)
            {
                <time class="dashboard-waste-lead-date" datetime="@nextDate.Value.ToString("yyyy-MM-dd")">
                    @nextDate.Value.ToString("dd.MM")
                </time>
            }
        </div>

        @if (laterItems.Count > 0)
        {
            <div class="dashboard-waste-rest" aria-label="Seinare tømmingar">
                @foreach (var tomming in laterItems)
                {
                    <div class="dashboard-waste-rest-row">
                        <span class="dashboard-waste-icon" aria-hidden="true">@tomming.Ikon</span>
                        <span class="dashboard-waste-rest-name">@tomming.Namn</span>
                        @if (tomming.NesteTomming is DateOnly date)
                        {
                            <time class="dashboard-waste-rest-date" datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("dd.MM")</time>
                            <span class="dashboard-waste-rest-days">@GetDaysText(date, today)</span>
                        }
                    </div>
                }
            </div>
        }
    }
</article>
